# Base URLs
BASE_URL=https://m.twitch.tv

# Timeouts (in seconds)
IMPLICIT_WAIT=5
EXPLICIT_WAIT=5
PAGE_LOAD_TIMEOUT=10

# Chrome browser settings
MOBILE_EMULATION=true
DEFAULT_DEVICE='iPhone 12 Pro'

# Screenshot settings
SCREENSHOT_ON_FAILURE=true
SCREENSHOT_DIR=screenshots

# Report settings
REPORT_DIR=reports
